# ==========================================
# OMNIFORGE / SWITCH AI HACKATHON CONFIGURATION
# ==========================================

# 1. Switch AI Gateway & Security
# Leave empty to use zero-token local simulation mode (Full multi-platform emulation)
SWITCH_API_KEY=
SWITCH_WEBHOOK_SECRET=
SWITCH_GATEWAY_URL=http://localhost:8000/api/switch

# API Gateway Key (Optional: leave empty for open development mode)
OMNIFORGE_API_KEY=
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000

# 2. Multi-Platform Bot Tokens (Optional - Zero-token mode runs without them!)
# Telegram: Get in 30s from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Discord: Get from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=

# Slack: Get from https://api.slack.com/apps
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# 3. Execution Engine & Docker Sandbox
# When True, executes test runs and builds inside isolated Docker containers
USE_DOCKER_SANDBOX=false
DOCKER_IMAGE=python:3.11-slim
WORKSPACE_DIR=./workspaces

# 4. Server Configuration
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./omniforge.db
